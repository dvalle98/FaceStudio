# ── Entorno ──────────────────────────────────────────────────────
.env
venv/
.venv/

# ── IDE ──────────────────────────────────────────────────────────
.vscode/
.idea/

# ── Dependencias y builds ────────────────────────────────────────
node_modules/
dist/
build/
__pycache__/
*.py[cod]

# ── Modelos DNN ───────────────────────────────────────────────────
# Los modelos se descargan localmente con setup_modelos.py.
# La carpeta se mantiene en el repo; su contenido no.
modelos/*
!modelos/.gitkeep

# ── Storage — carpetas de runtime ────────────────────────────────
# Se mantiene la estructura de carpetas (gracias a .gitkeep).
# Se ignora todo el contenido generado en tiempo de ejecución:
# imágenes subidas, imágenes procesadas, ZIPs y la base de datos de jobs.

storage/jobs.json

storage/*
!storage/.gitkeep
!storage/projects
!storage/entrada
!storage/salida
!storage/zips

storage/projects/*
!storage/projects/.gitkeep

storage/entrada/*
!storage/entrada/.gitkeep

storage/salida/*
!storage/salida/.gitkeep

storage/zips/*
!storage/zips/.gitkeep

# ── Carpetas legacy ───────────────────────────────────────────────
imagenes-entrada/
imagenes-salida/
